# Common switches for db-access-bootstrap scripts (admin-backend).
# Placeholder convention:
# - keep "tpl" in names so init.sh can replace it with real project name.
# - use "-" for service/secret names, "_" for db/user identifiers.

ENABLE_POSTGRESQL=true
ENABLE_REDIS=true
ENABLE_MONGODB=false

NAMESPACE=default
# 默认使用本 backend 目录下 db-provisioner（便于整仓单独迁出）；可用环境变量 DBCTL_BIN 覆盖
if [[ -z "${DBCTL_BIN:-}" ]]; then
  DBCTL_BIN="$(cd "${SCRIPT_DIR}/.." && pwd)/db-provisioner/bin/dbctl"
fi

BASE_ENV_TEMPLATE=${SCRIPT_DIR}/config/base.env.template
OUT_ENV=${SCRIPT_DIR}/.env.local.db
STRICT_FILE_CHECK=true

PG_CONFIG=${SCRIPT_DIR}/config/postgresql.external.env
REDIS_CONFIG=${SCRIPT_DIR}/config/redis.external.env
MONGO_CONFIG=${SCRIPT_DIR}/config/mongodb.external.env
PG_K8S_CONFIG=${SCRIPT_DIR}/config/postgresql.k8s.env
REDIS_K8S_CONFIG=${SCRIPT_DIR}/config/redis.k8s.env
MONGO_K8S_CONFIG=${SCRIPT_DIR}/config/mongodb.k8s.env
