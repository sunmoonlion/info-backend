SERVICE_NAME=tpl-admin-backend
ENVIRONMENT=dev
TARGET_MODE=external
DB_ENGINE=redis

DB_HOST=127.0.0.1
DB_PORT=6379
APP_DB_NAME=0
APP_DB_USER=tpl_admin_backend
APP_DB_PASSWORD=change_me

REDIS_ADMIN_USER=default
REDIS_ADMIN_PASSWORD=change_me
REDIS_DB_INDEX=0
REDIS_AUTH_ONLY=false
REDIS_KEY_PREFIX=tpl:*
REDIS_ACL_CATEGORY=+@read +@write +@hash +@string +@list +@set +@sortedset

OUTPUT_ENV_FILE=/tmp/tpl-admin-backend-redis.env
