SERVICE_NAME=tpl-admin-backend
ENVIRONMENT=dev
TARGET_MODE=external
DB_ENGINE=redis

DB_HOST=llmops.sunmoonai.com
DB_PORT=30446
APP_DB_NAME=0
APP_DB_USER=tpl_admin_backend
APP_DB_PASSWORD=TplAdminRedisAcl_7nR4wP2vK9mL3qX8j

REDIS_ADMIN_USER=default
REDIS_ADMIN_PASSWORD=StrongRedisPassw0rd!
REDIS_DB_INDEX=0
REDIS_AUTH_ONLY=false
# REDIS_KEY_PREFIX: space-separated patterns for ACL; quoted for bash source.
REDIS_KEY_PREFIX="session:* tpl:*"
REDIS_ACL_CATEGORY="+@read +@write +@connection +@hash +@string +@list +@set +@sortedset"

OUTPUT_ENV_FILE=/tmp/tpl-admin-backend-redis.env
