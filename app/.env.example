# Runtime identity
ENV=development
LOG_LEVEL=INFO
SERVICE_NAME=info-backend
DEPLOYMENT_ID=local
APP_SLUG=info

# One PostgreSQL owner and one canonical Alembic history per App.
DATABASE_URL=postgresql://info:change-me@localhost:5432/info
MIGRATION_DATABASE_URL=

# Redis session/cache ACL
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_USER=
REDIS_PASSWORD=

# Shared OIDC provider transport. Browser clients remain separate.
CASDOOR_ENDPOINT=https://identity.example.test
CASDOOR_DISCOVERY_URL=https://identity.example.test/.well-known/openid-configuration
CASDOOR_BACKCHANNEL_ENDPOINT=
CASDOOR_ORGANIZATION=built-in
CASDOOR_VERIFY_SSL=true

ADMIN_CASDOOR_CLIENT_ID=replace-me-admin
ADMIN_CASDOOR_CLIENT_SECRET=replace-me
ADMIN_CASDOOR_REDIRECT_URI=https://admin.example.test/api/auth/admin/callback
ADMIN_CASDOOR_APPLICATION=sunmoonai-info-admin
ADMIN_AUTH_POLICY_VERSION=info-admin-v2
ADMIN_AUTH_ROLE_ALLOWLIST=admin,operator
ADMIN_AUTH_SCOPE_ALLOWLIST=info:admin
ADMIN_FRONTEND_BASE_URL=https://admin.example.test
ADMIN_FRONTEND_ALLOWED_ORIGINS=https://admin.example.test
ADMIN_AUTH_DEFAULT_RETURN_TO=/
ADMIN_AUTH_ALLOWED_RETURN_PATHS=/

WEB_CASDOOR_CLIENT_ID=replace-me-web
WEB_CASDOOR_CLIENT_SECRET=replace-me
WEB_CASDOOR_REDIRECT_URI=https://web.example.test/api/auth/web/callback
WEB_CASDOOR_APPLICATION=sunmoonai-info-web
WEB_AUTH_POLICY_VERSION=info-web-v2
WEB_AUTH_ROLE_ALLOWLIST=member
WEB_AUTH_SCOPE_ALLOWLIST=profile:read
WEB_FRONTEND_BASE_URL=https://web.example.test
WEB_FRONTEND_ALLOWED_ORIGINS=https://web.example.test
WEB_AUTH_DEFAULT_RETURN_TO=/zh-CN/dashboard
WEB_AUTH_ALLOWED_RETURN_PATHS=/zh-CN/dashboard,/en/dashboard,/zh-CN/login,/en/login
WEB_FRONTEND_DEFAULT_LOCALE=zh-CN

AUTH_HTTP_TIMEOUT_SECONDS=10
AUTH_TRANSACTION_TTL_SECONDS=300
AUTH_DISCOVERY_CACHE_SECONDS=300
AUTH_JWKS_CACHE_SECONDS=300
AUTH_CLOCK_SKEW_SECONDS=30
AUTH_ALLOWED_ALGORITHMS=RS256,ES256
SESSION_TTL_SECONDS=3600
SESSION_COOKIE_SECURE=true
ALLOWED_HOSTS=admin.example.test,web.example.test

# Disabled by default and forbidden in production.
REFERENCE_INTERACTION_ENABLED=false

# Cross-App/provider HTTP only; never point this at the same Backend.
DOWNSTREAM_BASE_URL=
DOWNSTREAM_CLIENT_ID=
DOWNSTREAM_CLIENT_SECRET=
DOWNSTREAM_SCOPE=
DOWNSTREAM_ALLOWED_PATH_PREFIXES=/api/internal/v1
DOWNSTREAM_VERIFY_SSL=true
DOWNSTREAM_HTTP_TIMEOUT_SECONDS=15

# Internal service identity is disabled until both fields are configured.
SERVICE_AUTH_AUDIENCE=
SERVICE_AUTH_SUBJECT_BINDINGS_JSON={}

# Optional API producer / Worker configuration. Credentials belong in a Secret.
CELERY_QUEUE=info.default
# CELERY_BROKER_URL=amqp://info-producer:change-me@localhost:5672/tpl
# CELERY_RESULT_BACKEND=redis://info-worker:change-me@localhost:6379/0

# Info domain: durable distribution outbox
DELIVERY_OUTBOX_BATCH_SIZE=50
DELIVERY_OUTBOX_LEASE_SECONDS=30
DELIVERY_OUTBOX_ACK_TIMEOUT_SECONDS=300
DELIVERY_OUTBOX_RETRY_BASE_SECONDS=5
DELIVERY_OUTBOX_RETRY_MAX_SECONDS=300

# Info domain: object storage. Production injects S3 credentials via Secret.
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=.local-storage/info-originals
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=development-info-originals
S3_FORCE_PATH_STYLE=true
S3_USE_TLS=false

# Info domain: crawler
CRAWL_TIMEOUT_SECONDS=20
CRAWL_MAX_BYTES=10485760
CRAWL_USER_AGENT=SunmoonAI InfoAppBot/0.1

# Info domain: optional Elasticsearch/OpenSearch read model
SEARCH_BACKEND=disabled
ELASTICSEARCH_URL=https://localhost:9200
ELASTICSEARCH_INDEX=info-information
ELASTICSEARCH_TIMEOUT_SECONDS=10
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_CA_CERT_PATH=/var/run/secrets/sunmoonai/elasticsearch/ca.crt
ELASTICSEARCH_ALIASES=

# Info -> Knowledge relation. Client secret belongs in a Secret.
KNOWLEDGE_APP_INGEST_URL=http://knowledge-backend/api/internal/v1/knowledge/ingestions
KNOWLEDGE_APP_SERVICE_APPLICATION=sunmoonai-info-knowledge-ingest
KNOWLEDGE_APP_SERVICE_DISCOVERY_URL=
KNOWLEDGE_APP_SERVICE_BACKCHANNEL_ENDPOINT=
KNOWLEDGE_APP_SERVICE_CLIENT_ID=
KNOWLEDGE_APP_SERVICE_CLIENT_SECRET=
KNOWLEDGE_APP_SERVICE_SCOPE=knowledge:ingest
KNOWLEDGE_APP_TIMEOUT_SECONDS=20
