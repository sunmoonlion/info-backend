SERVICE_NAME=tpl-admin-backend
ENVIRONMENT=dev
TARGET_MODE=k8s
DB_ENGINE=redis

# ⚠️ 部署前必须修改：填写实际的 k8s Redis Service DNS
# 格式：<service-name>.<data-namespace>.svc.cluster.local
# 示例：redis-sunmoonai-master.data-platform-dev.svc.cluster.local
DB_HOST=redis-sunmoonai-master.data-platform-dev.svc.cluster.local
DB_PORT=6379
APP_DB_NAME=0
APP_DB_USER=tpl_admin_backend
APP_DB_PASSWORD=TplAdminRedisAcl_7nR4wP2vK9mL3qX8j

REDIS_ADMIN_USER=default
REDIS_ADMIN_PASSWORD=Re!d1359admin
REDIS_DB_INDEX=0
REDIS_AUTH_ONLY=false
REDIS_KEY_PREFIX="session:* tpl:*"
REDIS_ACL_CATEGORY="+@read +@write +@connection +@hash +@string +@list +@set +@sortedset"

# ⚠️ 部署前必须修改：填写应用部署的命名空间
OUTPUT_NAMESPACE=CHANGEME-app-namespace
OUTPUT_SECRET_NAME=tpl-admin-backend-redis-conn
