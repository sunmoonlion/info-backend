# k8s 场景连接串（内部 Service DNS），由 setup-k8s-db-access.sh 生成。
# 仅在 Pod 内部可用，不可直接用于本机开发。
# ⚠️ 使用前请先填写 config/postgresql.k8s.env 和 config/redis.k8s.env 中的 DB_HOST / OUTPUT_NAMESPACE。
APP_ENV=production
DATABASE_URL=postgresql://tpl_admin_user:CHANGEME@postgresql.CHANGEME-data-namespace.svc.cluster.local:5432/tpl_admin
REDIS_HOST=redis.CHANGEME-data-namespace.svc.cluster.local
REDIS_PORT=6379
REDIS_DB=0
REDIS_USER=tpl_admin_backend
REDIS_PASSWORD=CHANGEME
