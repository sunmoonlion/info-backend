SERVICE_NAME=tpl-admin-backend
ENVIRONMENT=dev
TARGET_MODE=k8s
DB_ENGINE=postgresql

# ⚠️ 部署前必须修改：填写实际的 k8s PostgreSQL Service DNS
# 格式：<service-name>.<data-namespace>.svc.cluster.local
# 示例：postgresql-sunmoonai.data-platform-dev.svc.cluster.local
DB_HOST=postgresql.CHANGEME-data-namespace.svc.cluster.local
DB_PORT=5432
APP_DB_NAME=tpl_admin
APP_DB_USER=tpl_admin_user
APP_DB_PASSWORD=Po!s1359

PG_ADMIN_USER=postgres
PG_ADMIN_PASSWORD=Po!s1359admin
PG_ADMIN_DB=postgres
PG_SSLMODE=prefer

# ⚠️ 部署前必须修改：填写应用部署的命名空间
OUTPUT_NAMESPACE=CHANGEME-app-namespace
OUTPUT_SECRET_NAME=tpl-admin-backend-postgresql-conn
