# 基础配置
ENV=development
LOG_LEVEL=INFO

# 数据库
SQLALCHEMY_DATABASE_URI=postgresql+asyncpg://tpl:tpl@localhost:5432/tpl

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Casdoor BFF
# BFF_PROVIDER=backend（此服务承担 BFF，REDIRECT_URI 指向本服务）
CASDOOR_ENDPOINT=https://casdoor.example.com
CASDOOR_CLIENT_ID=your_client_id
CASDOOR_CLIENT_SECRET=your_client_secret
CASDOOR_REDIRECT_URI=http://localhost:8000/api/auth/callback
CASDOOR_ORGANIZATION=built-in
CASDOOR_APPLICATION=app-tpl

# Session
SESSION_TTL_SECONDS=3600
