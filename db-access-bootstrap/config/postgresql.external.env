SERVICE_NAME=tpl-admin-backend
ENVIRONMENT=dev
TARGET_MODE=external
DB_ENGINE=postgresql

DB_HOST=127.0.0.1
DB_PORT=5432
APP_DB_NAME=tpl_admin
APP_DB_USER=tpl_admin_user
